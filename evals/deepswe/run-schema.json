{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LoomGraph Evaluation v1 run record",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "condition",
    "use_mode",
    "trial_id",
    "agent",
    "environment",
    "packet",
    "verifier"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string"},
    "condition": {"enum": ["baseline", "treatment"]},
    "use_mode": {"enum": ["voluntary", "assisted"]},
    "trial_id": {"type": "string"},
    "agent": {
      "type": "object",
      "required": ["name", "model"],
      "properties": {
        "name": {"type": "string"},
        "model": {"type": "string"},
        "version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["image", "architecture"],
      "properties": {
        "image": {"type": "string"},
        "image_digest": {"type": "string"},
        "architecture": {"enum": ["linux/amd64", "linux/arm64"]},
        "backend": {"enum": ["codeindex", "codegraph"]},
        "limits": {"type": "object"}
      },
      "additionalProperties": false
    },
    "packet": {
      "type": "object",
      "required": [
        "status",
        "source_clean",
        "source_clean_scope",
        "instrumentation_cache_paths",
        "response_format"
      ],
      "properties": {
        "status": {"type": "string"},
        "source_clean": {"type": "boolean"},
        "source_clean_scope": {"const": "model_phase"},
        "instrumentation_cache_paths": {
          "type": "array",
          "items": {"type": "string"}
        },
        "response_format": {"enum": ["raw_json", "markdown_fenced", "invalid"]},
        "semantic_packet": {"type": "boolean"},
        "candidate_paths": {"type": "array", "items": {"type": "string"}},
        "target_hit_at_5": {"type": ["boolean", "null"]},
        "existing_target_recall_at_5": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "new_path_nominated_at_5": {"type": ["boolean", "null"]},
        "loomgraph_invoked": {"type": "boolean"},
        "loomgraph_retrieval_used": {"type": "boolean"},
        "loomgraph_retrieval_succeeded": {"type": ["boolean", "null"]},
        "loomgraph_index_only": {"type": "boolean"},
        "uncached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cost_usd": {"type": ["number", "null"], "minimum": 0},
        "agent_execution_seconds": {"type": ["number", "null"], "minimum": 0},
        "agent_setup_seconds": {"type": ["number", "null"], "minimum": 0},
        "trial_wall_seconds": {"type": ["number", "null"], "minimum": 0},
        "tool_call_count": {"type": "integer", "minimum": 0},
        "tool_call_budget": {"type": "integer", "minimum": 1},
        "tool_call_budget_overrun": {"type": "boolean"},
        "retrieval_required": {"type": "boolean"},
        "retrieval_requirement_met": {"type": ["boolean", "null"]}
      },
      "additionalProperties": false
    },
    "loomgraph": {"type": "object"},
    "verifier": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["disabled", "not_run", "pass", "fail", "error"]},
        "reward": {}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
