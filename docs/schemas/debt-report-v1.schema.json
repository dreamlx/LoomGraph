{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/dreamlx/LoomGraph/schemas/debt-report-v1.schema.json",
  "title": "LoomGraph Technical Debt Report",
  "description": "Standard format for LoomGraph technical debt analysis reports",
  "type": "object",
  "required": [
    "schema_version",
    "timestamp",
    "project",
    "overall_health",
    "issues"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Schema version (semantic versioning)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Report generation timestamp (ISO 8601)"
    },
    "project": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+(:[a-zA-Z0-9_-]+)?$",
      "description": "Project name or project:branch (workspace format)",
      "examples": [
        "my-project",
        "my-project:main",
        "my-project:develop"
      ]
    },
    "generator": {
      "type": "object",
      "required": [
        "tool",
        "version"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "description": "Tool name",
          "examples": [
            "loomgraph"
          ]
        },
        "version": {
          "type": "string",
          "description": "Tool version",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?$",
          "examples": [
            "0.9.0",
            "0.9.0-beta.1"
          ]
        },
        "command": {
          "type": "string",
          "description": "Exact command used to generate the report",
          "examples": [
            "loomgraph debt --module src"
          ]
        }
      }
    },
    "overall_health": {
      "type": "object",
      "required": [
        "total_score",
        "grade",
        "breakdown",
        "summary"
      ],
      "properties": {
        "total_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Overall health score (0-100)"
        },
        "grade": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "F"
          ],
          "description": "Letter grade: A(≥90), B(80-89), C(70-79), D(60-69), F(<60)"
        },
        "breakdown": {
          "type": "object",
          "properties": {
            "topology": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "Topology health score (from topology command)"
            },
            "quality": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "Code quality score (average of multi-dimensional scores)"
            },
            "test_coverage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "Test coverage percentage (if available)"
            },
            "maintainability": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 100,
              "description": "null = no codeindex data flowed in (#153 提案 2)"
            }
          },
          "additionalProperties": false
        },
        "summary": {
          "type": "object",
          "required": [
            "total_entities",
            "p0_issues",
            "p1_issues",
            "p2_issues"
          ],
          "properties": {
            "total_entities": {
              "type": "integer",
              "minimum": 0,
              "description": "Total number of entities in the project"
            },
            "p0_issues": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of critical issues (P0)"
            },
            "p1_issues": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of moderate issues (P1)"
            },
            "p2_issues": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of minor issues (P2)"
            }
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "description": "List of detected technical debt issues",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "category",
          "entity",
          "entity_type",
          "location",
          "metrics"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^debt-\\d{3,}$",
            "description": "Unique issue ID (e.g., debt-001)",
            "examples": [
              "debt-001",
              "debt-042"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2"
            ],
            "description": "Issue severity: P0(critical), P1(moderate), P2(minor)"
          },
          "category": {
            "type": "string",
            "description": "Issue category (open set; topology/git/static analyzers add categories over time)"
          },
          "entity": {
            "type": "string",
            "description": "Entity name (class, function, module)",
            "examples": [
              "UserService",
              "processOrder",
              "auth"
            ]
          },
          "entity_type": {
            "type": "string",
            "description": "Entity type (open set: class/function/method/module/file/variable/property/... depends on exporter)"
          },
          "location": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "description": "File path (relative to project root)",
                "examples": [
                  "src/services/UserService.ts"
                ]
              },
              "start_line": {
                "type": "integer",
                "minimum": 1,
                "description": "Start line number"
              },
              "end_line": {
                "type": "integer",
                "minimum": 1,
                "description": "End line number"
              }
            }
          },
          "metrics": {
            "type": "object",
            "properties": {
              "lines": {
                "type": "integer",
                "minimum": 0,
                "description": "Lines of code"
              },
              "methods": {
                "type": "integer",
                "minimum": 0,
                "description": "Number of methods (for classes)"
              },
              "maintainability_score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10,
                "description": "Maintainability score (0-10)"
              },
              "testability_score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10,
                "description": "Testability score (0-10)"
              },
              "impact_radius_score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10,
                "description": "Impact radius score (0-10)"
              },
              "coupling_score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10,
                "description": "Coupling score (0-10)"
              },
              "total_score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 40,
                "description": "Total quality score (sum of 4 dimensions, 0-40)"
              }
            },
            "description": "Metric payload varies by issue category (static/topology/git); union of the documented keys."
          },
          "details": {
            "type": "object",
            "description": "Additional context-specific details",
            "properties": {
              "in_degree": {
                "type": "integer",
                "minimum": 0,
                "description": "Number of incoming dependencies"
              },
              "out_degree": {
                "type": "integer",
                "minimum": 0,
                "description": "Number of outgoing dependencies"
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "List of dependency names"
              },
              "circular_chain": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Circular dependency chain (if applicable)"
              }
            }
          },
          "suggestion": {
            "type": "string",
            "description": "Suggested remediation action",
            "examples": [
              "拆分为 UserAuth + UserProfile + UserSettings"
            ]
          },
          "estimated_effort": {
            "type": "object",
            "properties": {
              "days": {
                "type": "string",
                "pattern": "^\\d+(-\\d+)?$",
                "description": "Estimated effort in days (e.g., '3', '3-5')",
                "examples": [
                  "3",
                  "3-5",
                  "10-15"
                ]
              },
              "complexity": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "description": "Refactoring complexity"
              }
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Affected files (tests, dependents, etc.)"
          }
        }
      }
    },
    "trends": {
      "type": "object",
      "description": "Historical trends (optional, requires previous reports)",
      "properties": {
        "period": {
          "type": "string",
          "enum": [
            "1_month",
            "3_months",
            "6_months",
            "1_year"
          ],
          "description": "Analysis period"
        },
        "debt_increase": {
          "type": "string",
          "pattern": "^[+-]\\d+%$",
          "description": "New debt percentage (e.g., '+15%')",
          "examples": [
            "+15%",
            "-5%"
          ]
        },
        "debt_repayment": {
          "type": "string",
          "pattern": "^[+-]\\d+%$",
          "description": "Resolved debt percentage",
          "examples": [
            "-8%",
            "+3%"
          ]
        },
        "net_change": {
          "type": "string",
          "pattern": "^[+-]\\d+%$",
          "description": "Net debt change",
          "examples": [
            "+7%",
            "-10%"
          ]
        },
        "hotspots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "module",
              "change"
            ],
            "properties": {
              "module": {
                "type": "string",
                "description": "Module path"
              },
              "change": {
                "type": "string",
                "pattern": "^[+-]\\d+%$",
                "description": "Debt change in this module"
              }
            }
          },
          "description": "Modules with fastest debt growth"
        },
        "comparison": {
          "type": "object",
          "properties": {
            "previous_report": {
              "type": "string",
              "description": "Path to previous report file"
            },
            "score_delta": {
              "type": "integer",
              "description": "Total score change (positive = improvement)"
            },
            "new_issues": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of new issues"
            },
            "resolved_issues": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of resolved issues"
            }
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "description": "Prioritized refactoring recommendations",
      "items": {
        "type": "object",
        "required": [
          "priority",
          "action",
          "target",
          "description"
        ],
        "properties": {
          "priority": {
            "type": "integer",
            "minimum": 1,
            "description": "Priority rank (1 = highest)"
          },
          "action": {
            "type": "string",
            "enum": [
              "refactor",
              "rewrite",
              "delete",
              "isolate"
            ],
            "description": "Recommended action type"
          },
          "target": {
            "type": "string",
            "description": "Target entity name"
          },
          "description": {
            "type": "string",
            "description": "Action description"
          },
          "estimated_effort_days": {
            "type": "string",
            "pattern": "^\\d+(-\\d+)?$",
            "description": "Estimated effort in days"
          },
          "expected_roi": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "description": "Expected return on investment"
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Blocking factors"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Detailed implementation steps"
          }
        }
      }
    }
  }
}
