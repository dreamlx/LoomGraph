# LoomGraph 客户注册表模板
# 复制为 customers.yaml 并填写实际配置
#
# 用法:
#   cp customers/customers.yaml.example customers/customers.yaml
#   # 编辑 customers.yaml 填写客户信息
#   python scripts/package.py --all
#
# Token 管理:
#   python scripts/manage_tokens.py --check-expiry
#   python scripts/manage_tokens.py --list
#
# 详细文档: docs/guides/TOKEN_MANAGEMENT.md

example_customer:
  name: "示例客户"
  contact: "张三 <zhangsan@example.com>"  # 客户联系人（可选）

  # GitHub Token 信息（敏感，不提交 Git）
  # 创建方法: https://github.com/settings/tokens?type=beta
  github_token_name: "loomgraph-example-20260224"  # Token 名称（便于在 GitHub 识别）
  github_token_created: "2026-02-24"               # 创建日期
  github_token_expires: "2026-05-25"               # 过期日期（提前 30 天预警）
  github_token_last_4: "a1b2"                      # Token 最后 4 位（用于识别，不要写完整 token）

  # 服务配置
  lightrag_url: "http://your-server:3001"
  language_hint: "Python"           # Python | Java | PHP
  language_parser: "ai-codeindex"   # ai-codeindex[java] | ai-codeindex[php]
  exclude_dirs: "__pycache__/, .git/"

