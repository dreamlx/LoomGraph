# LoomGraph 客户注册表模板
# 复制为 customers/customers.yaml 并填写实际配置
#
# 用法:
#   cp customers/customers.yaml.example customers/customers.yaml
#   # 编辑 customers.yaml 填写客户信息
#   python scripts/package.py --all
#
# 注: v0.16+ 走公开 PyPI (pipx install loomgraph)，不再需要 GitHub Token /
#     LightRAG URL。此处仅保留客户元数据用于生成客户专用 README。
#     私有客户如需独立分发，自行扩展。

example_customer:
  name: "示例客户"
  contact: "张三 <zhangsan@example.com>"  # 客户联系人（可选）
  language_hint: "Python"           # Python | Java | TypeScript（用于 README 安装提示）

# another_customer:
#   name: "另一个客户"
#   contact: "李四 <lisi@another.com>"
#   language_hint: "Java"
